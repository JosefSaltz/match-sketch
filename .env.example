# Local development: run `pnpm db:start && pnpm db:env` to write .env from the local stack.
# Production: set these in Coolify (see docs/operations.md).

# Public, inlined at build time (Coolify: build and runtime).
SUPABASE_URL="http://127.0.0.1:54321"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_…"

# Private, read at runtime by the server only.
SUPABASE_SECRET_KEY="sb_secret_…"
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres"

# Local only: Mailpit, where the local stack delivers invite emails (used by e2e tests).
MAILPIT_URL="http://127.0.0.1:54324"
